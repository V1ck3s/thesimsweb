# Copy to .env and adjust (read by docker compose).
# The install folder of The Sims (not needed with THESIMSWEB_GAME_FILES=client)
SIMS_DIR=/srv/sims/Les Sims
THESIMSWEB_PORT=3000
THESIMSWEB_BIND=127.0.0.1
# server (one shared set of saves on the server) or client (each player's saves in their browser)
THESIMSWEB_SAVES=server
# server (the game files of SIMS_DIR) or client (each player imports their own copy of the
# game into their browser: the server serves no game file, and the saves stay in the browsers)
THESIMSWEB_GAME_FILES=server
