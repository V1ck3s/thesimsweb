{
  "name": "thesimsweb",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Web reimplementation of The Sims (2000) Complete Edition",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./{client,server}\" run dev",
    "build": "pnpm run build:wasm && pnpm --filter @thesimsweb/client --filter @thesimsweb/server run build",
    "build:wasm": "wasm-pack build --target web --scope thesimsweb crates/wasm-bindings",
    "start": "node scripts/start.mjs",
    "check-game": "node scripts/check-game.mjs",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "msw"]
  }
}
